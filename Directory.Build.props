<Project>

    <!--
        Shared build settings. Without this file nothing enforced style, and the same question got two answers in
        different files: _camelCase fields beside bare ones, [GeneratedRegex] beside new Regex(..., Compiled),
        private methods suffixed Async beside a public API with none.
    -->
    <PropertyGroup>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisMode>Recommended</AnalysisMode>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!--
        The shipped package is the strict one: a warning fails its build so the public surface cannot drift again.
        Test and demo projects stay on warnings, because a noisy analyzer should never block running the tests.
    -->
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Hosting.Diagrid'">
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- CS1591 (missing XML doc on a public member) is a separate cleanup; documented members are the norm here. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <!--
            Symbols and Source Link. The .NET 8+ SDK carries Source Link itself, which is why the packed
            nuspec already has <repository commit="...">; no Microsoft.SourceLink.GitHub reference is needed.
            A .snupkg beside the .nupkg is what lets a consumer step into this code from their debugger.
        -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <!--
        Normalises source paths so Source Link resolves for consumers. Set only in CI: switching it on
        locally makes local builds non-reproducible against CI output for no benefit.
    -->
    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

</Project>
