<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Hosting.Diagrid\Hosting.Diagrid.csproj" />
    <!-- Build-order only. The fake must NOT be copied into this project's output: on Windows a bare
         process name resolves from the calling process's own directory first, which would bypass PATH. -->
    <!-- The fake is an out-of-process stand-in that stays net10.0 whichever framework this project runs on, so
         the reference pins it to net10.0 instead of negotiating a framework match. -->
    <ProjectReference Include="..\FakeDiagrid\FakeDiagrid.csproj" ReferenceOutputAssembly="false" Private="false" SetTargetFramework="TargetFramework=net10.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\fixtures\*.json" Link="fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Share the scenario types by source, since the fake's assembly is not referenced. -->
    <Compile Include="..\FakeDiagrid\Scenario.cs" Link="Scenario.cs" />
  </ItemGroup>

  <!-- Locate the fake by asking its own project where it builds, so the path follows -o, ArtifactsPath and
       OutputPath overrides and never depends on a hand-written separator (a backslash is a literal filename
       character on Linux). The directory is handed to the tests as assembly metadata. -->
  <Target Name="EmbedFakeDiagridDir" BeforeTargets="GetAssemblyAttributes">
    <MSBuild Projects="..\FakeDiagrid\FakeDiagrid.csproj" Properties="TargetFramework=net10.0" Targets="GetTargetPath" SkipNonexistentTargets="false">
      <Output TaskParameter="TargetOutputs" ItemName="_FakeDiagridTarget" />
    </MSBuild>
    <PropertyGroup>
      <_FakeDiagridDir>$([System.IO.Path]::GetDirectoryName('%(_FakeDiagridTarget.FullPath)'))</_FakeDiagridDir>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>FakeDiagridDir</_Parameter1>
        <_Parameter2>$(_FakeDiagridDir)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

</Project>
