<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Hosting.Diagrid\Hosting.Diagrid.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.Dapr" />
    <PackageReference Include="Aspire.Hosting.Dotnet" />
    <!-- The demo wiring is compiled in from the AppHost so the tests exercise the code that actually runs. -->
    <Compile Include="..\..\AppHost\DemoWiring.cs" Link="DemoWiring.cs" />
    <Content Include="..\..\AppHost\Resources\*.yaml" Link="Resources\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\fixtures\*.json" Link="fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="public-surface.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Read as data by the packaging tests. Copied, not referenced, so the assertions survive the
         output-path differences between the three target frameworks. -->
    <Content Include="..\..\Hosting.Diagrid\Hosting.Diagrid.csproj" Link="packaging\Hosting.Diagrid.csproj" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\.github\workflows\release.yaml" Link="packaging\release.yaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\.github\workflows\ci.yaml" Link="packaging\ci.yaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\global.json" Link="packaging\global.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\Directory.Build.props" Link="packaging\Directory.Build.props" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Hosting.Diagrid.Tests.csproj" Link="packaging\Hosting.Diagrid.Tests.csproj" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Hosting.Diagrid.IntegrationTests\Hosting.Diagrid.IntegrationTests.csproj" Link="packaging\Hosting.Diagrid.IntegrationTests.csproj" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Hosting.Diagrid.SmokeTests\Hosting.Diagrid.SmokeTests.csproj" Link="packaging\Hosting.Diagrid.SmokeTests.csproj" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
