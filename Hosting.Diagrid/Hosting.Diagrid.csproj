<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Authors>Diagrid</Authors>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Diagrid.Aspire.Hosting</RootNamespace>
        <PackageId>Diagrid.Aspire.Hosting</PackageId>
        <AssemblyName>Diagrid.Aspire.Hosting</AssemblyName>
        <IsPackable>true</IsPackable>
        <PackageIcon>logo.png</PackageIcon>
        <PackageReadmeFile>readme.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/diagrid-labs/diagrid-aspire</RepositoryUrl>
        <!--
            Without an explicit Description, MSBuild packs the literal placeholder "Package Description".
            Every version published so far (0.0.1 through 1.0.0) carries it on nuget.org.
        -->
        <Description>.NET Aspire hosting integration for Diagrid. Declare a Diagrid project, apps, agents, managed KV stores and pub/sub brokers, components and subscriptions in your AppHost, and the integration provisions them through the Diagrid CLI when you run it. Built so that moving a Dapr OSS service to Diagrid needs no change to the service's own code.</Description>
        <PackageProjectUrl>https://github.com/diagrid-labs/diagrid-aspire</PackageProjectUrl>
        <PackageTags>aspire;dapr;diagrid;catalyst;distributed-applications;workflow;pubsub;statestore</PackageTags>
        <!--
            SPDX expression rather than PackageLicenseFile: nuget.org renders it as a known licence on the
            package page instead of an attachment to open. The LICENSE file at the repo root is what GitHub
            reads; the two must stay in agreement.
        -->
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <Copyright>Copyright (c) 2026 Diagrid</Copyright>
    </PropertyGroup>

    <ItemGroup>
        <!-- todo: Is this the package we should be depending on? -->
        <PackageReference Include="Aspire.Hosting.AppHost"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Hosting.Diagrid.IntegrationTests" />
        <InternalsVisibleTo Include="Hosting.Diagrid.Tests" />
        <InternalsVisibleTo Include="Hosting.Diagrid.SmokeTests" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="Logo\*.txt" />
    </ItemGroup>
    
    <ItemGroup>
        <!--
            logo.png is generated from logo.svg, which came from diagridio/dotnet-ai, with:
              magick -background none -density 1200 properties/logo.svg                 -resize 128x128 -gravity center -extent 128x128 -depth 8 properties/logo.png
            128x128 is NuGet's recommended icon size. None, not Content: the icon is packaging
            input, not something a consuming build should carry. The value of PackageIcon must
            match an archive entry path exactly, or nuget.org renders a default icon.
        -->
        <None Include="../properties/logo.png" Pack="true" PackagePath="/" />
        <Content Include="../readme.md" Pack="true" PackagePath="/">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

</Project>
