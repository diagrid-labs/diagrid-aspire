<Project Sdk="Aspire.AppHost.Sdk/13.4.5">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UserSecretsId>73c42576-88b9-44a1-be3b-bfa4fcfd97d9</UserSecretsId>
        <RootNamespace>Diagrid.Aspire.Test.AppHost</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="CommunityToolkit.Aspire.Hosting.Dapr" />
      <!--
           Deliberately versionless. Aspire.AppHost.Sdk reads PackageVersion under central package management,
           so this resolves to the 13.1.0 in Directory.Packages.props rather than the SDK's own 13.4.5. Running
           the demo at the floor Hosting.Catalyst declares is the point: it is the minimum a consumer gets, and
           nothing else exercises it.

           Moving this project to 13.4.5 is not just a version change. Aspire 13.4.5 requires OpenTelemetry
           >= 1.15.3, while transitive pinning forces the central 1.14.0, so a VersionOverride here fails
           restore with NU1109. Raising the two OpenTelemetry PackageVersions is the prerequisite.
      -->
      <PackageReference Include="Aspire.Hosting.AppHost" />
      <ProjectReference Include="..\Hosting.Catalyst\Hosting.Catalyst.csproj" IsAspireProjectResource="false" />
      <ProjectReference Include="..\TestApi\TestApi.csproj" />
    </ItemGroup>

</Project>
