<Project Sdk="Aspire.AppHost.Sdk/13.6.5">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UserSecretsId>73c42576-88b9-44a1-be3b-bfa4fcfd97d9</UserSecretsId>
        <RootNamespace>Diagrid.Aspire.Test.AppHost</RootNamespace>
        <!--
            ASPIRE010 (AspireUseCliBundle=false) is 13.6.5's own default and fires on every build. Turning the
            bundle on needs the Aspire CLI on PATH, which CI does not have. Silenced here instead, because the
            build step is where analyzer violations are meant to stand out and a permanent warning trains
            people past it. Nothing in this demo uses a bundle-only feature.
        -->
        <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="CommunityToolkit.Aspire.Hosting.Dapr" />
      <!--
           Deliberately versionless. Aspire.AppHost.Sdk reads PackageVersion under central package management,
           so this resolves to the version in Directory.Packages.props. Running the demo at the floor
           Hosting.Catalyst declares is the point: it is the minimum a consumer gets, and nothing else
           exercises it.

           That floor is 13.6.5 because GHSA-f7vh-h5g3-7jrh (CVE-2026-120006) affects every Aspire.Hosting
           below it. Lowering it brings the advisory back, and with the NU1902/NU1903 waiver gone that fails
           restore rather than warning. The central OpenTelemetry versions are 1.17.0 because 13.6.5 needs
           >= 1.17.0; putting them back below that fails restore with NU1109. The Sdk version on line 1 is
           kept level with the package so the SDK is never older than what it builds.
      -->
      <PackageReference Include="Aspire.Hosting.AppHost" />
      <ProjectReference Include="..\Hosting.Catalyst\Hosting.Catalyst.csproj" IsAspireProjectResource="false" />
      <ProjectReference Include="..\TestApi\TestApi.csproj" />
    </ItemGroup>

</Project>
