<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UserSecretsId>73c42576-88b9-44a1-be3b-bfa4fcfd97d9</UserSecretsId>
        <RootNamespace>Diagrid.Aspire.Test.AppHost</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="CommunityToolkit.Aspire.Hosting.Dapr" />
      <!--
           Deliberately versionless: central package management supplies the version from
           Directory.Packages.props. Running the demo at the floor Hosting.Diagrid declares is the point:
           it is the minimum a consumer gets, and nothing else exercises it.

           That floor is 17.0.0, the current release. It is also comfortably above
           GHSA-f7vh-h5g3-7jrh (CVE-2026-120006), which affects every Aspire.Hosting below 13.6.5: lowering
           the pin past that brings the advisory back, and with the NU1902/NU1903 waiver gone it fails
           restore rather than warning. The central OpenTelemetry versions are 1.18.0 because 17.0.0 needs
           >= 1.18.0; putting them back below that fails restore with NU1109.

           This project is on Microsoft.NET.Sdk with these two packages referenced explicitly, which is the
           layout Aspire 17 documents. Aspire.AppHost.Sdk still works but warns ASPIRE012, and its one real
           advantage, generating Projects.* metadata from ProjectReference items, is not needed here:
           AddDotnetProject takes a path.
      -->
      <PackageReference Include="Aspire.Hosting.AppHost" />
      <!-- AddDotnetProject lives here. Project v2 replaced AddProject<TProject> in Aspire 17. -->
      <PackageReference Include="Aspire.Hosting.Dotnet" />
      <ProjectReference Include="..\Hosting.Diagrid\Hosting.Diagrid.csproj" />
      <!--
           Build ordering only. AddDotnetProject starts TestApi from its path, so the AppHost does not
           compile against its assembly, but the project still has to be built before the demo runs.
      -->
      <ProjectReference Include="..\TestApi\TestApi.csproj" ReferenceOutputAssembly="false" />
    </ItemGroup>

</Project>
