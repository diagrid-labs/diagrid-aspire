<Project>

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>

    <!--
        Two things to know before changing a version here.

        1. CentralPackageTransitivePinningEnabled promotes any PackageVersion that appears in a project's
           TRANSITIVE graph into a real dependency of that project's package. Hosting.Catalyst references
           one package, Aspire.Hosting.AppHost, but its published nuspec now declares four: that one plus
           MessagePack and two OpenTelemetry packages. The OpenTelemetry entries exist in this file only
           because ServiceDefaults, a demo project, needs them. So bumping a version for the demo changes
           the published package's dependency contract, and published versions are immutable. Kept on
           purpose rather than worked around: the spec requires transitive pinning (R2), and the MessagePack
           floor carries the security fix downstream to consumers. Check the packed nuspec after any change
           here. The three OpenTelemetry.Instrumentation.* pins do not reach Hosting.Catalyst and do not
           appear in the nuspec.

        2. Aspire.Hosting.AppHost is 13.6.5 because GHSA-f7vh-h5g3-7jrh (CVE-2026-120006, high, elevation
           of privilege) affects every Aspire.Hosting below it, and the OpenTelemetry versions are 1.17.0
           because 13.6.5 requires >= 1.17.0. 1.14.0 carried four advisories of its own, all patched at or
           below 1.15.3. Both bumps self-defend: lowering either fails restore, with the advisory or NU1109.
    -->
    <ItemGroup>
        <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.5" />
        <PackageVersion Include="CommunityToolkit.Aspire.Hosting.Dapr" Version="13.0.0" />
        <PackageVersion Include="Dapr.AspNetCore" Version="1.17.9" />
        <PackageVersion Include="Dapr.Workflow" Version="1.17.9" />
        <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.1.0" />
        <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.1.0" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
        <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
        <PackageVersion Include="xunit" Version="2.9.3" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
        <PackageVersion Include="Xunit.SkippableFact" Version="1.5.23" />
        <!--
            Transitive pin, load-bearing although nothing references MessagePack directly.
            As of this pin: Aspire.Hosting.AppHost 13.6.5 -> Aspire.Hosting -> StreamJsonRpc 2.25.29 ->
            MessagePack 2.5.302, which still carries GHSA-qhrr-8q5h-9q3h. 2.5.303 patches it and 2.5.307 is
            the latest 2.5.x, so this stays inside the minor line StreamJsonRpc asked for.
            Transitive pinning is on, so this applies whichever path introduces it.
            Re-check whenever Aspire.Hosting.AppHost is bumped, and check the resolved MessagePack version
            rather than assuming a newer Aspire fixed it: every Aspire release so far has resolved to a
            MessagePack that is still vulnerable.
        -->
        <PackageVersion Include="MessagePack" Version="2.5.307" />
    </ItemGroup>

</Project>
